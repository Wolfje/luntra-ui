# Normalise all text files to LF in the repo and in the working tree.
# Prettier is configured with endOfLine: "lf"; without this, Git's autocrlf
# on Windows rewrites checkouts to CRLF and `prettier --check` fails.
* text=auto eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary

# Generated — collapse in diffs and exclude from language stats
pnpm-lock.yaml linguist-generated=true -diff
