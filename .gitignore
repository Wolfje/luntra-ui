# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.output/
.nitro/
.tanstack/
*.tsbuildinfo

# `build/` is deliberately NOT ignored here. It reads as "output" to most
# tools, so build tooling lives in `plugins/` instead — an ignore rule that
# silently swallows source is a very expensive kind of quiet.

# Test output
coverage/
.vitest-cache/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Env
.env
.env.*
!.env.example

# Generated by `pnpm build:tokens` from src/tokens/source.
# Committing these would let the CSS and its TypeScript source drift apart,
# and make every token change show up twice in review.
packages/luntra-ui/src/styles/tokens.css
packages/luntra-ui/src/styles/themes/
